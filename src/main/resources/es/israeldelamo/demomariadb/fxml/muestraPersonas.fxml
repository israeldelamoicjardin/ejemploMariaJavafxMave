<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" minHeight="480.0" minWidth="640.0" prefHeight="480.0" prefWidth="640.0" spacing="20.0" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.israeldelamo.demomariadb.controladores.ControladorMuestraPersonas">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <MenuBar maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" useSystemMenuBar="true">
     <menus>
       <Menu fx:id="miArchivo" mnemonicParsing="true" text="%Archivo">
         <items>
           <MenuItem accelerator="Shortcut+S" mnemonicParsing="false" onAction="#onArchivoCerrar" text="%Cerrar" />
         </items>
       </Menu>
       <Menu mnemonicParsing="true" text="%Editar">
         <items>
           <MenuItem accelerator="Shortcut+E" mnemonicParsing="false" onAction="#onEdicionEliminar" text="%Eliminar" />
         </items>

       </Menu>
       <Menu mnemonicParsing="true" text="%Ayuda">
         <items>
           <MenuItem accelerator="Shortcut+Y" mnemonicParsing="false" onAction="#onAcercaDeClick" text="Acera de" />
         </items>

       </Menu>
     </menus>
      <padding>
         <Insets bottom="5.0" top="5.0" />
      </padding>
   </MenuBar>
   <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="%TituloApp" VBox.vgrow="NEVER">
      <font>
         <Font size="26.0" />
      </font>
   </Label>

    <Label fx:id="welcomeText" />
    <Button onAction="#onActualizarButton" text="%Actualizar">
      <tooltip>
         <Tooltip text="Refresca la tabla inferior" />
      </tooltip>
      <graphic>

      </graphic>
      <graphic>
         <FontIcon accessibleText="Actualizar" fontSmoothingType="LCD" iconColor="#8a2d2d" iconLiteral="fa-recycle" iconSize="20" selectionEnd="2" selectionFill="#1b293c" styleClass="h2" />
      </graphic></Button>
   <TableView fx:id="tvDni" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="388.0" prefWidth="600.0" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
     <columns>

         <TableColumn fx:id="tcDni" maxWidth="1.7976931348623157E308" minWidth="100.0" prefWidth="100.0" text="%Dni" />
         <TableColumn fx:id="tcNombre" maxWidth="1.7976931348623157E308" minWidth="100.0" prefWidth="100.0" text="%Nombre" />
         <TableColumn fx:id="tcApellidos" maxWidth="1.7976931348623157E308" minWidth="100.0" prefWidth="100.0" text="%Apellidos" />
     </columns>
   </TableView>
</VBox>
